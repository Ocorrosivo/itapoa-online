# ========================================================
# 🌍 ENVIRONMENT VARIABLES — GUIA COMERCIAL ITAPOÁ
# ========================================================
# Copy this file to .env and fill in the values.

# Application — produção pública: https://itapoa.online
# Produção administrativa (Easypanel): https://itapoa.tech
NODE_ENV=production
PORT=3000
APP_URL=https://itapoa.online
API_URL=https://itapoa.online/api

# Persistent uploads directory (absolute path recommended so
# uploaded files survive redeploys). Defaults to ./uploads if unset.
# UPLOAD_DIR=/home/uXXXX/uploads

# Database (MySQL / MariaDB)
DB_HOST=srv887.hstgr.io
DB_PORT=3306
DB_NAME=u619805679_itapoa
DB_USER=u619805679_itapoa
DB_PASSWORD=your_secure_password_here

# Auth — must be a long random string (>= 32 chars)
JWT_SECRET=generate-a-very-long-secure-random-string-here
JWT_EXPIRES_IN=7d

# E-mail recovery: optional; missing SMTP or migration disables recovery only.
# Configure secrets in the application's Easypanel environment, never in Git.
# Confirm the real provider/host before enabling; 465 = TLS, 587 = STARTTLS.
# Host, user and sender must be explicit for both registration and recovery.
# Accepted aliases: SMTP_USERNAME, SMTP_PASS and EMAIL_FROM.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contato@itapoa.online

# Payments (Mercado Pago) — all optional; site works degraded without them.
# When unset, POST /api/payments/* returns 503 (web) stays up.
# APP_USR- is production (Orders/Checkout Pro); TEST- is Checkout API/Bricks — both valid.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Optional explicit validation contract: production or test. Never point test
# credentials at the production database. APP_USR alone does not prove live mode.
MERCADOPAGO_MODE=production
# Optional restricted checkout offer. OFF unless all three are explicitly set.
# ISO UTC dates ending in Z; maximum 24 hours. Existing subscriptions reserve
# one attempt per authenticated account/method, including rejected/unknown ones.
# Never use the payer e-mail as proof of account identity.
PAYMENT_TEST_ACCOUNT_EMAIL=
PAYMENT_TEST_STARTS_AT=
PAYMENT_TEST_EXPIRES_AT=
# Register exactly this URL in the Mercado Pago dashboard (same origin as APP_URL):
#   https://itapoa.online/api/webhooks/mercadopago
# Webhook activation is the only path that marks a subscription paid.
