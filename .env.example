# ========================================================
# 🌍 ENVIRONMENT VARIABLES FOR HOSTINGER DEPLOYMENT
# ========================================================
# Copy this file to .env and fill in the values for production

# Application Environment (development or production)
NODE_ENV=production

# Server Port (Usually ignored by Hostinger Node.js app, but good practice)
PORT=3000

# Base URLs (produção na VPS — Caddy itapoa.tech)
APP_URL=https://itapoa.tech
API_URL=https://itapoa.tech/api

# Persistent uploads directory (absolute path recommended in production so
# uploaded files survive redeploys). Defaults to ./uploads if unset.
# UPLOAD_DIR=/home/uXXXX/uploads

# Database Configuration (MySQL / MariaDB on Hostinger)
DB_HOST=srv887.hstgr.io
DB_PORT=3306
DB_NAME=u619805679_itapoa
DB_USER=u619805679_itapoa
DB_PASSWORD=your_secure_password_here

# JWT Authentication Secret (Must be a long random string)
JWT_SECRET=generate-a-very-long-secure-random-string-here
JWT_EXPIRES_IN=7d

# Payment Gateway (Mercado Pago — Subscriptions)
# VITE_MP_PUBLIC_KEY is public and safe for the browser (CardPayment tokenization only)
# MERCADOPAGO_ACCESS_TOKEN is server-only — never expose
VITE_MP_PUBLIC_KEY=
# Feature flag — keep OFF until commercial rules are defined (plans/values/period/cancel)
VITE_SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
