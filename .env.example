# ========================================================
# 🌍 ENVIRONMENT VARIABLES — Guia Comercial Itapoá
# ========================================================
# Copie este arquivo para .env e preencha os valores de produção.
# Nunca commite .env com segredos. Veja HOSTINGER_DEPLOY.md / VPS_DEPLOY.md.

# Application Environment (development or production)
NODE_ENV=production

# Server Port (a VPS expõe via Caddy/Traefik; o app deve escutar 0.0.0.0:PORT)
PORT=3000

# Base URLs
# Público principal (site + API): https://itapoa.online
# Easypanel (gestão): https://itapoa.tech — NÃO use para canonical/sitemap
APP_URL=https://itapoa.online
API_URL=https://itapoa.online/api

# Persistent uploads directory (absoluto recomendado em produção para
# sobreviver a redeploys). Ex.: /opt/itapoa/app/uploads ou volume Docker.
# UPLOAD_DIR=/opt/itapoa/app/uploads

# Database Configuration (MySQL / MariaDB privado na VPS/rede interna)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itapoa_online
DB_USER=itapoa_user
DB_PASSWORD=your_secure_password_here

# JWT Authentication Secret (mínimo 32 caracteres, aleatório)
JWT_SECRET=generate-a-very-long-secure-random-string-here
JWT_EXPIRES_IN=7d

# Payment Gateway (Mercado Pago) — opcional até ativar cobranças reais
# notification_url = ${APP_URL}/api/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Google Identity Services (OAuth 2.0 Web) — somente se ativar "Continuar com Google"
# Origens autorizadas: https://itapoa.online e https://www.itapoa.online
# Nunca exponha o secret no frontend; apenas GOOGLE_CLIENT_ID pode ser público (VITE_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# E-mail transacional (ex.: Resend, SES, Hostinger SMTP)
# Credenciais somente no servidor (variáveis de ambiente) e DNS SPF/DKIM/DMARC.
# EMAIL_FROM="Itapoa Online <no-reply@itapoa.online>"
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
